# Conversion outputs and run logs left in the checkout (-logdir defaults to the working
# directory). Only these: a blanket *.ttl would hide new .ttl sources and test fixtures.
/*.ttl
/*.ttl.gz
/*.nt
/*.nt.gz
dcm2rdf-*.log.ttl

# NetBeans run configurations, which hold local paths
nbactions*.xml

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.lck

# cert files/SSL Stuff
*.pem
*.p12
cacerts
cacerts.p12
*.cer

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
target/*

# odd files
dependency-reduced-pom.xml

# local code review notes
REVIEW.md
